{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "repo-security-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/internal/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repo-security-lab",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUESTER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "USERNAME_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "INTERNAL_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "PUBLIC_SCANNING_ENABLED": "false",
    "PRIVATE_SLICE_LOGINS": "ri7in",
    "PRIVATE_SLICE_ACCOUNT_IDS": ""
  }
}
