{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "repo-security-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repo-security-lab",
      "database_id": "6776e6f9-efc8-494c-ba4a-380eb33300bb",
      "preview_database_id": "6776e6f9-efc8-494c-ba4a-380eb33300bb",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUESTER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "READ_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "USERNAME_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "INTERNAL_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://repo-security-lab.rivinsand.workers.dev",
    "PUBLIC_SCANNING_ENABLED": "false",
    "OPENROUTER_KEY_POOL_SIZE": "2",
    "PRIVATE_SLICE_LOGINS": "ri7in",
    "PRIVATE_SLICE_ACCOUNT_IDS": "121791882"
  }
}
